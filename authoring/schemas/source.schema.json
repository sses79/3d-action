{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Animation Studio source v1",
  "type": "object",
  "properties": {
    "library": {
      "const": "ual2-standard"
    },
    "edition": {
      "type": "string"
    },
    "license": {
      "const": "CC0-1.0"
    },
    "path": {
      "type": "string"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceRig": {
      "type": "string"
    },
    "targetRig": {
      "const": "quaternius-ual1"
    },
    "adapter": {
      "type": "string"
    }
  },
  "required": [
    "library",
    "edition",
    "license",
    "path",
    "sha256",
    "sourceRig",
    "targetRig",
    "adapter"
  ],
  "additionalProperties": false
}
