{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "rig": {
      "const": "quaternius-ual1"
    },
    "id": {
      "type": "string",
      "pattern": "^[-a-z0-9]{1,48}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "intent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "movementId": {
            "type": "string",
            "pattern": "^[-a-z0-9]{1,48}$"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "speed": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 1.5
          },
          "connection": {
            "type": "object",
            "properties": {
              "contractId": {
                "type": "string",
                "pattern": "^[-a-z0-9]{1,48}$"
              },
              "duration": {
                "type": "number",
                "minimum": 0.016,
                "maximum": 1
              },
              "blend": {
                "enum": [
                  "pose",
                  "velocity"
                ]
              },
              "travel": {
                "enum": [
                  "source",
                  "continue"
                ]
              }
            },
            "required": [
              "contractId",
              "duration"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "movementId",
          "revision",
          "speed"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "rig",
    "id",
    "name",
    "intent",
    "steps"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Animation Studio semantic action specification v1"
}
